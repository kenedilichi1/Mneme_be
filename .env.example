# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME="Mneme API"
APP_VERSION="1.0.0"
# true = log OTP codes and skip sending email (development only; rejected in production)
DEBUG=false
SQL_ECHO=false
LOG_LEVEL=INFO
ENVIRONMENT=development
# JSON list. Browsers only; the React Native app doesn't need an entry. "*" is rejected in production.
CORS_ORIGINS=["*"]

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mneme

# ── Auth ──────────────────────────────────────────────────────────────────────
# At least 32 random characters in production; generate with: openssl rand -hex 32
jwt_secret=change-me
jwt_algorithm=HS256
# Key for hashing OTP codes (HMAC-SHA256). Required in production; generate
# with: openssl rand -hex 32. Rotating it only invalidates outstanding OTPs.
otp_hash_key=
otp_expire_minutes=10
jwt_expire_minutes=15
refresh_token_expire_days=30

# ── Brute-force protection ────────────────────────────────────────────────────
# Failed OTP verifications allowed per email before the lockout window opens
OTP_MAX_FAILED_ATTEMPTS=5
OTP_LOCKOUT_MINUTES=15
# Rate limits (per minute, stored in Postgres so all processes share them)
GLOBAL_RATE_LIMIT_PER_MINUTE=100
OTP_REQUEST_LIMIT_PER_MINUTE=5
OTP_VERIFY_LIMIT_PER_MINUTE=10
# true ONLY behind a trusted reverse proxy that sets X-Forwarded-For;
# otherwise clients can spoof the header to rotate their rate-limit key
TRUST_PROXY_HEADERS=false

# ── Email (optional in development) ───────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Mneme <onboarding@resend.dev>"

# ── Backblaze B2 Storage ─────────────────────────────────────────────────────
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
# Bucket's S3 endpoint (B2 web UI → Buckets → "Endpoint"), e.g. https://s3.us-west-004.backblazeb2.com
B2_S3_ENDPOINT=
MAX_UPLOAD_BYTES=104857600
UPLOAD_URL_EXPIRE_SECONDS=900

# ── Local / Nomic Embeddings ──────────────────────────────────────────────────
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
# Exact HuggingFace commit the model is loaded at — required in production (40-char
# sha). Bump only together with re-embedding existing chunks.
EMBEDDING_MODEL_REVISION=e9b6763023c676ca8431644204f50c2b100d9aab
EMBEDDING_DIMENSION=768
# Max tokens per chunk, counted with the Nomic tokenizer
MAX_CHUNK_TOKENS=512

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
WORKER_PREFETCH_COUNT=1

